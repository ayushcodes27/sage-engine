# Copy to infra/.env (gitignored) and adjust. Docker Compose reads it automatically when started with
#   docker compose -f infra/docker-compose.yml up -d
# Every variable is optional; the values below are the compose defaults unless noted.

# Host port for Redis. Set to e.g. 6390 if a host Redis already owns 6379.
SAGE_REDIS_HOST_PORT=6379

# Shared secret between the gateway and the live traffic generator (load-tests/diverse-shadow-traffic.py).
# Required for live campaigns; generate one with: openssl rand -hex 16
# Never commit a real value.
SAGE_PROBE_SECRET=

# Token for the gateway's route admin API (POST /admin/routes, header X-SAGE-Admin-Token).
# Leave empty to keep the admin API disabled. Generate one with: openssl rand -hex 16
# Never commit a real value.
SAGE_ADMIN_TOKEN=

# Which direct peers may set the client IP via X-Forwarded-For / X-Real-IP (comma-separated IPs/CIDRs, or *).
# Empty = loopback + private ranges (127.0.0.0/8, ::1, 10/8, 172.16/12, 192.168/16, fc00::/7), which covers the
# local traffic generators. Set it to your load balancer's address when the gateway faces the internet.
SAGE_TRUSTED_PROXIES=

# Gateway ML mode: off | features | sync | async. Campaigns use async; only the overhead benchmark changes it.
SAGE_ML_MODE=async

# Comma-separated extra shadow model files scored by sage-ml (campaign C uses eclog6m_prefix_8feature_v1.pkl).
# Each file must be listed in a frozen manifest, or sage-ml refuses to start.
EXTRA_SHADOW_MODEL_FILES=

# Grafana admin password (http://localhost:5050, user "admin"). Defaults to "admin" for local use;
# set a real one on any shared or exposed machine. Grafana applies it only when its data volume is first created.
GRAFANA_ADMIN_PASSWORD=admin
